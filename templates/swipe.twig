{% extends 'layout/base.twig' %}

{% block title %}{{ trans('dating.swipe.title') }} – {{ site_name }}{% endblock %}

{% block content %}
<h1>{{ trans('dating.swipe.title') }}</h1>

{% if likes_left is not null %}
    <p><small>{{ trans('dating.swipe.likes_left', {count: likes_left}) }}</small></p>
{% endif %}

{% if candidate %}
    <article class="date-card">
        <div class="date-card-photo"{% if candidate.photo %} style="background-image:url('{{ url(candidate.photo.large) }}')"{% endif %}>
            {% if not candidate.photo %}<span class="date-card-initial" aria-hidden="true">{{ candidate.display_name|first|upper }}</span>{% endif %}
        </div>
        {% if candidate.distance_km is not null %}
            <span class="date-card-badge">{{ trans('dating.swipe.distance', {km: candidate.distance_km}) }}</span>
        {% endif %}
        <div class="date-card-content">
            <h2>{{ candidate.display_name }}, {{ candidate.age }}</h2>
            {% if candidate.city %}<p class="date-card-city">{{ candidate.city }}</p>{% endif %}
            {% if candidate.bio %}<p class="date-card-bio">{{ candidate.bio }}</p>{% endif %}
        </div>
    </article>

    <div class="date-actions">
        <form method="post" action="{{ url('/dating/swipe/pass') }}" class="inline-form">
            {{ csrf_field() }}
            <input type="hidden" name="target_account_id" value="{{ candidate.account_id }}">
            <button type="submit" class="date-action date-action-pass" aria-label="{{ trans('dating.swipe.pass') }}">✕</button>
        </form>
        <form method="post" action="{{ url('/dating/swipe/like') }}" class="inline-form">
            {{ csrf_field() }}
            <input type="hidden" name="target_account_id" value="{{ candidate.account_id }}">
            <button type="submit" class="date-action date-action-like" aria-label="{{ trans('dating.swipe.like') }}">♥</button>
        </form>
    </div>
{% else %}
    <p class="empty">{{ trans('dating.swipe.none_left') }}</p>
{% endif %}

{% if can_rewind %}
    <form method="post" action="{{ url('/dating/swipe/rewind') }}" class="inline-form">
        {{ csrf_field() }}
        <button type="submit" class="link-button">{{ trans('dating.swipe.rewind') }}</button>
    </form>
{% endif %}
{% endblock %}
