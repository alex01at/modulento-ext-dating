{% extends 'layout/base.twig' %}

{% block title %}{{ trans('dating.matches.title') }} – {{ site_name }}{% endblock %}

{% block content %}
<h1>{{ trans('dating.matches.title') }}</h1>

{% if liked_by_count > 0 %}
    <p class="flash">
        {% if can_see_who_liked %}
            {{ trans('dating.matches.liked_by', {count: liked_by_count}) }}
        {% else %}
            {{ trans('dating.matches.liked_by_locked', {count: liked_by_count}) }}
        {% endif %}
    </p>
{% endif %}

{% if matches is empty %}
    <p class="empty">{{ trans('dating.matches.none') }}</p>
{% else %}
    <ul class="date-match-list">
        {% for match in matches %}
            <li>
                <a class="date-match-item" href="{{ url('/dating/matches/' ~ match.id) }}">
                    <span class="date-avatar">
                        {% if match.other and match.other.photo %}
                            <img src="{{ url(match.other.photo.thumb) }}" alt="">
                        {% else %}
                            {{ (match.other.display_name ?? '?')|first|upper }}
                        {% endif %}
                    </span>
                    <strong>{{ match.other.display_name ?? trans('dating.matches.unknown') }}</strong>
                    {% if match.unread > 0 %}<span class="date-unread-badge">{{ match.unread }}</span>{% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}

<p><a href="{{ url('/dating/swipe') }}">{{ trans('dating.matches.back_to_swipe') }}</a></p>
{% endblock %}
